# Глобальні налаштування
align=center
color=#cdd6f4
separator=true
separator_block_width=10
markup=pango
# markup=none

# [journal]
# command=journalctl -o cat -n 1
# interval=30

[airquality]
command=TEMP_OFFSET=0 HUM_OFFSET=0 $HOME/.config/i3blocks/scripts/ens160.sh
interval=60
markup=none

[bluetooth]
label=
command=if [ "${BLOCK_BUTTON:-0}" -eq 1 ]; then ~/.config/i3blocks/scripts/toggle_bluetooth.sh; fi; if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then DEVICES=$(bluetoothctl devices Connected 2>/dev/null | wc -l); echo "$DEVICES"; else echo "OFF"; fi
interval=1
color=#89b4fa

[layout]
command=xkblayout-state print "%s" | sed 's/^us$/EN/; s/^ua$/UA/' && echo
interval=1
signal=12
color=#ff8800

[weather]
command=~/.config/i3blocks/scripts/wttr-kharkiv
interval=1800
color=#89dceb

[disk]
command=~/.config/i3blocks/scripts/disk_check.sh
interval=30
min_width= 999G

[memory]
label= 
command=LANG=C free -h | awk '/^Mem:/ {print $3 "/" $2}'
interval=10
color=#89b4fa
min_width= 7.5G/7.5G

[wifi]
label= 
command=WLAN=$(ip route | awk '/default/ {print $5}' | grep '^w'); if [ -n "$WLAN" ]; then iwgetid -r $WLAN; else echo "down"; fi
interval=10
color=#89b4fa
# min_width= 1234567890

[network_speed]
command=~/.config/i3blocks/scripts/network_speed.sh
interval=2
color=#a6adc8
min_width=.9MB99.9MB

[cpu_usage]
interval=1
command=if [ "${BLOCK_BUTTON:-0}" -eq 1 ]; then ~/.config/i3blocks/scripts/toggle_taskmanager.sh; fi; ~/.config/i3blocks/scripts/cpu.sh
min_width=⣿⣿99/99

[temperature]
label=
command=sensors | awk '/^Package id 0:/ {print $4}' | sed 's/\.[0-9]*°C//'
interval=10
color=#f38ba8
# min_width= +99.9°C

[screensaver]
command=~/.config/i3blocks/scripts/toggle_screensaver.sh
interval=once

[battery]
command=STATUS=$(acpi -b | awk -F, '{print $1}' | awk '{print $3}'); PERC=$(acpi -b | awk -F, '{print $2}' | tr -d ' %'); if [ "$STATUS" = "Charging" ]; then echo " $PERC%"; elif [ "$PERC" -le 20 ]; then echo " $PERC%"; else echo " $PERC%"; fi
interval=10
color=#f9e2af
min_width= 100%

[time]
label= 
command=date '+%A_%u %B_%m %d %H:%M'
interval=5
color=#a6e3a1

[screenshot]
full_text=
command=if [ "${BLOCK_BUTTON:-0}" -eq 1 ]; then (sleep 2; maim --select | tee /home/$USER/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png | xclip -selection clipboard -t image/png) >/dev/null 2>&1 & fi
interval=once

[rofi]
full_text=>_
command=case "$BLOCK_BUTTON" in 1) rofi -modi drun,run -show drun ;; esac
interval=once

[volume]
command=~/.config/i3blocks/scripts/volume.sh
interval=once
signal=10
color=#a6e3a1
min_width= 100%
