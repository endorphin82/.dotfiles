# Глобальні налаштування
align=center
color=#E0E0E0
separator=true
separator_block_width=10

[journal]
command=journalctl -o cat -n 1
interval=1

[bluetooth]
label= 
command=if [ "$BLOCK_BUTTON" -eq 1 ]; then ~/.config/i3blocks/toggle_bluetooth.sh; fi; if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then DEVICES=$(bluetoothctl devices Connected 2>/dev/null | wc -l); echo "$DEVICES"; else echo "OFF"; fi
interval=1
color=#4c7899

[layout]
command=xkblayout-state print "%s:%n" &&echo 
interval=1

